# Copy this file to .env and fill in your credentials.
# .env is gitignored – never commit real credentials.

# ─── Jira ────────────────────────────────────────────────────────────────────
# Your Atlassian site URL (no trailing slash)
JIRA_BASE_URL=https://your-company.atlassian.net

# The email address you log in to Jira with
JIRA_EMAIL=you@your-company.com

# A Jira API token – generate one at:
#   https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_jira_api_token_here

# ─── Confluence ──────────────────────────────────────────────────────────────
# Usually the same site URL as Jira
CONFLUENCE_BASE_URL=https://your-company.atlassian.net

CONFLUENCE_EMAIL=you@your-company.com

# A Confluence API token (can be the same token as Jira if they share a site)
CONFLUENCE_API_TOKEN=your_confluence_api_token_here
